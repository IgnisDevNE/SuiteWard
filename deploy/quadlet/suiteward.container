# The SuiteWard service. Outbound only: both published ports (8081 HTTP, 8091 MCP) are bound to the host's loopback, so they are reached from the host only.
# suiteward-migrate.service runs first (Requires/After) and waits for the database itself; serve never migrates and never sees the owner URL.
[Unit]
Description=SuiteWard
Wants=network-online.target
After=network-online.target
Requires=suiteward-migrate.service
After=suiteward-migrate.service
StartLimitIntervalSec=0

[Container]
# Pinned by digest: replace <digest> (podman image inspect --format '{{.Digest}}' <image>), and change suiteward-migrate.container to the same line.
Image=ghcr.io/ignisdevne/suiteward@sha256:<digest>
ContainerName=suiteward
Network=suiteward.network
# The container listens on all its interfaces; the host side is loopback only.
PublishPort=127.0.0.1:8081:8080
# The MCP listener (image default SUITEWARD_MCP_ADDR=0.0.0.0:8090); it still needs its bearer token.
PublishPort=127.0.0.1:8091:8090
# The application role URL (never the owner URL), the GitHub App key and the MCP token are podman secrets mounted as files; they are never environment variables.
Secret=suiteward-database-url,type=mount,target=/run/secrets/database-url,uid=65532,mode=0400
Environment=SUITEWARD_DATABASE_URL_FILE=/run/secrets/database-url
Secret=suiteward-github-app-key,type=mount,target=/run/secrets/github-app-key,uid=65532,mode=0400
Environment=SUITEWARD_GITHUB_APP_KEY_FILE=/run/secrets/github-app-key
Secret=suiteward-mcp-token,type=mount,target=/run/secrets/mcp-token,uid=65532,mode=0400
Environment=SUITEWARD_MCP_TOKEN_FILE=/run/secrets/mcp-token
# SUITEWARD_GITHUB_APP_ID, SUITEWARD_GITHUB_INSTALLATION_ID and SUITEWARD_GITHUB_REPOSITORIES (not secrets) come from a file the owner
# writes on the host (deploy/HOST.md, section 4a); the values are never committed. A missing file makes podman fail the start, which
# Restart=always repeats and the journal shows; it never runs silently without GitHub.
EnvironmentFile=/etc/suiteward/github.env
# D-TIER: this host is the isolated tier (only the owner has a shell here); the tier is declared, never detected.
Environment=SUITEWARD_INSTALLATION_TIER=isolated
Volume=suiteward-data.volume:/data
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# The stop timeout (45 s) must exceed SUITEWARD_SHUTDOWN_TIMEOUT (30 s by default). It and the memory limit go through PodmanArgs (Podman 5.5 or later).
PodmanArgs=--memory=256m --stop-timeout=45

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
