# The SuiteWard service. Outbound only: both published ports (8081 HTTP, 8091 MCP) are bound to loopback and reached through SSM port forwarding.
# Quadlet 4.9 has no Notify=healthy, so the database is ordered with Requires/After only. If it is not accepting connections yet,
# the service exits 1 at startup (no retry loop inside the process) and Restart=always tries again.
[Unit]
Description=SuiteWard
Wants=network-online.target
After=network-online.target
Requires=suiteward-db.service
After=suiteward-db.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/ignisdevne/suiteward:deploy
ContainerName=suiteward
# Polled by podman-auto-update.timer (daily by default); the host pulls, nothing pushes to it.
AutoUpdate=registry
Network=suiteward.network
# The container listens on all its interfaces; the host side is loopback only.
PublishPort=127.0.0.1:8081:8080
# The MCP listener (image default SUITEWARD_MCP_ADDR=0.0.0.0:8090); it still needs its bearer token.
PublishPort=127.0.0.1:8091:8090
# The full database URL, the GitHub App key and the MCP token are podman secrets mounted as files; they are never environment variables.
Secret=suiteward-database-url,type=mount,target=/run/secrets/database-url,uid=65532,mode=0400
Environment=SUITEWARD_DATABASE_URL_FILE=/run/secrets/database-url
Secret=suiteward-github-app-key,type=mount,target=/run/secrets/github-app-key,uid=65532,mode=0400
Environment=SUITEWARD_GITHUB_APP_KEY_FILE=/run/secrets/github-app-key
Secret=suiteward-mcp-token,type=mount,target=/run/secrets/mcp-token,uid=65532,mode=0400
Environment=SUITEWARD_MCP_TOKEN_FILE=/run/secrets/mcp-token
# SUITEWARD_GITHUB_APP_ID, SUITEWARD_GITHUB_INSTALLATION_ID and SUITEWARD_GITHUB_REPOSITORIES (not secrets) come from a file the owner
# writes on the host (deploy/HOST.md, section 5); the values are never committed. A missing file makes podman fail the start, which
# Restart=always repeats and the journal shows; it never runs silently without GitHub.
EnvironmentFile=/etc/suiteward/github.env
Volume=suiteward-data.volume:/data
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
# The stop timeout (45 s) must exceed SUITEWARD_SHUTDOWN_TIMEOUT (30 s by default). No quadlet key for it or the memory limit in 4.9.
PodmanArgs=--memory=256m --stop-timeout=45

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
